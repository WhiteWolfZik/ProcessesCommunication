        <mxCell id="note1" value="build PacketHeader:&#10;sequenceNumber = seq++&#10;timestampNs = now()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="195" width="220" height="55" as="geometry"/></mxCell>
