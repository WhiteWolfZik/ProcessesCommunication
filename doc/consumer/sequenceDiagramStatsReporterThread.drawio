<mxfile host="app.diagrams.net">
  <diagram id="seq_stats_reporter_thread" name="Consumer - StatsReporterThread tick">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="380" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="StatsReporterThread: one tick (wakes every reportIntervalSeconds)" style="text;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="reporter" value="StatsReporterThread" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="sig" value="SignalController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="collector" value="StatsCollector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="console" value="Console (stdout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="ll_reporter" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="80" as="sourcePoint"/><mxPoint x="130" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_sig" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="80" as="sourcePoint"/><mxPoint x="410" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_collector" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="80" as="sourcePoint"/><mxPoint x="680" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_console" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="80" as="sourcePoint"/><mxPoint x="900" y="340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1" value="1: isPaused()" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="120" as="sourcePoint"/><mxPoint x="410" y="120" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2: return bool" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="170" as="sourcePoint"/><mxPoint x="130" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="frame" value="opt   [not paused]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="195" width="850" height="140" as="geometry"/></mxCell>
        <mxCell id="m3" value="3: snapshot()" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="225" as="sourcePoint"/><mxPoint x="680" y="225" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4: return StatsSnapshot" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="270" as="sourcePoint"/><mxPoint x="130" y="270" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5: print(total, packets/sec, bytes/sec)" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="315" as="sourcePoint"/><mxPoint x="900" y="315" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
