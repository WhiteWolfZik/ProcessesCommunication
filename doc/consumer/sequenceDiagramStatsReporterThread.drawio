<mxfile host="app.diagrams.net">
  <diagram id="seq_stats_reporter_thread" name="Consumer - StatsReporterThread tick">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="StatsReporterThread: one tick (thread body, wakes every interval_)" style="text;align=left;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="800" height="30" as="geometry"/></mxCell>
        <mxCell id="reporter" value="StatsReporterThread" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="sig" value="SignalController" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="collector" value="StatsCollector" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="40" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="console" value="Console (stdout)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="160" height="40" as="geometry"/></mxCell>
        <mxCell id="ll_reporter" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="80" as="sourcePoint"/><mxPoint x="130" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_sig" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="80" as="sourcePoint"/><mxPoint x="410" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_collector" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="80" as="sourcePoint"/><mxPoint x="680" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll_console" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="80" as="sourcePoint"/><mxPoint x="900" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note0" value="sleep in wakePollInterval (100ms) chunks until interval_ elapses,&#10;rechecking running_ each chunk so stop() responds within ~100ms&#10;instead of blocking for a full interval_" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="m1" value="1: isPaused()" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="180" as="sourcePoint"/><mxPoint x="410" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2: return bool" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="230" as="sourcePoint"/><mxPoint x="130" y="230" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="frame" value="opt   [running_ and not paused]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="255" width="850" height="140" as="geometry"/></mxCell>
        <mxCell id="m3" value="3: snapshot()" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="285" as="sourcePoint"/><mxPoint x="680" y="285" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="4: return StatsSnapshot" style="html=1;endArrow=open;endFill=0;dashed=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="330" as="sourcePoint"/><mxPoint x="130" y="330" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="5: print(total, invalid, packets/sec, bytes/sec) + flush()" style="html=1;endArrow=block;endFill=1;rounded=0;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="375" as="sourcePoint"/><mxPoint x="900" y="375" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
